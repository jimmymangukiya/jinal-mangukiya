{%- comment %} Product grid with "+" hotspots and a popup per product. Add-on rule: Black + Medium also adds the add-on product. {% endcomment -%}
<link rel="stylesheet" href="{{ 'gift-guide-grid.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'gift-guide-grid.css' | asset_url | stylesheet_tag }}</noscript>
<script src="{{ 'gift-guide-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  if section.settings.enable_addon
    assign addon_product = section.settings.addon_product
  endif
  assign addon_variant = addon_product.selected_or_first_available_variant
  assign addon_image = addon_variant.featured_image | default: addon_product.featured_image
-%}

{%- comment %} Settings for the script are passed as data attributes {% endcomment -%}
<section
  class="gift-guide-container gift-guide-grid gift-guide-section-space"
  style="
    --section-space-top-desktop: {{ section.settings.space_top_desktop }}px;
    --section-space-top-mobile: {{ section.settings.space_top_mobile }}px;
    --section-space-bottom-desktop: {{ section.settings.space_bottom_desktop }}px;
    --section-space-bottom-mobile: {{ section.settings.space_bottom_mobile }}px;
  "
  data-gift-guide-grid
  data-addon-variant-id="{{ addon_variant.id }}"
  data-addon-product-id="{{ addon_product.id }}"
  data-addon-product-title="{{ addon_product.title | escape }}"
  data-addon-image-src="{% if addon_image != blank %}{{ addon_image | image_url: width: 128 }}{% endif %}"
  data-trigger-color="{{ section.settings.trigger_color | downcase | escape }}"
  data-trigger-size="{{ section.settings.trigger_size | downcase | escape }}"
  data-text-addon-added="{{ section.settings.text_addon_added | escape }}"
  data-text-choose="{{ section.settings.text_choose | escape }}"
  data-text-sold-out="{{ section.settings.text_sold_out | escape }}"
  data-text-error="Something went wrong, please try again"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="gift-guide-grid__heading gift-guide-text gift-guide-text--{{ section.settings.heading_style }}">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ul class="gift-guide-grid__list" role="list">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}

      {%- comment %} "+" position is set per block; it is on the <li> because the 4K product card uses it too {% endcomment -%}
      <li
        class="gift-guide-grid__item"
        style="
          --hotspot-x-desktop: {{ block.settings.hotspot_x_desktop }}%;
          --hotspot-y-desktop: {{ block.settings.hotspot_y_desktop }}%;
          --hotspot-x-mobile: {{ block.settings.hotspot_x_mobile }}%;
          --hotspot-y-mobile: {{ block.settings.hotspot_y_mobile }}%;
        "
        {{ block.shopify_attributes }}
        data-gift-guide-product
        data-product-id="{{ product.id }}"
      >

        {%- comment %} Product image, or a placeholder until a product is chosen {% endcomment -%}
        <div class="gift-guide-grid__media">
          {%- if product != blank and product.featured_image != blank -%}
            {{ product.featured_image | image_url: width: 900 | image_tag: class: 'gift-guide-grid__image', alt: product.title, loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 50vw' }}
          {%- else -%}
            {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'gift-guide-grid__image gift-guide-grid__image--placeholder' }}
          {%- endif -%}
        </div>

        {%- if product != blank -%}
          {%- comment %} "+" button: opens the popup (from 1920px it shows a small product card first) {% endcomment -%}
          <button
            type="button"
            class="gift-guide-grid__hotspot"
            aria-haspopup="dialog"
            aria-controls="gift-guide-popup-{{ block.id }}"
            aria-label="Choose options for: {{ product.title | escape }}"
            data-popup-open
          >
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <circle cx="10" cy="10" r="10" fill="#E9E9EA"/>
              <path d="M10 5V15M5 10H15" stroke="#000" stroke-width="1.5"/>
            </svg>
          </button>

          {%- render 'gift-guide-product-popup', product: product, popup_id: block.id -%}
        {%- endif -%}

      </li>
    {%- endfor -%}
  </ul>
</section>

{%- comment %} "Added to cart" notification (top-right), filled in by gift-guide-grid.js {% endcomment -%}
<div class="gift-guide-toast" role="status" aria-live="polite" data-gift-guide-toast>
  <div class="gift-guide-toast__body">
    <p class="gift-guide-toast__message">{{ section.settings.text_added }}</p>
    {%- comment %} One row per added product, built by the script {% endcomment -%}
    <ul class="gift-guide-toast__items" role="list" data-toast-items></ul>
    <a class="gift-guide-toast__link" href="{{ routes.cart_url }}">{{ section.settings.text_view_cart }}</a>
  </div>
  <button type="button" class="gift-guide-toast__close" aria-label="{{ 'accessibility.close' | t }}" data-toast-close>
    <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
      <path d="M2 2L18 18M18 2L2 18" stroke="currentColor" stroke-width="2"/>
    </svg>
  </button>
</div>

{% schema %}
{
  "name": "Gift guide grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading text style",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "body",
          "label": "Body text"
        }
      ],
      "default": "h2",
      "info": "Changes the size and font only."
    },
    {
      "type": "header",
      "content": "Add-on product"
    },
    {
      "type": "checkbox",
      "id": "enable_addon",
      "label": "Enable add-on product",
      "default": true,
      "info": "Turn off if you do not want an extra product added to the cart."
    },
    {
      "type": "paragraph",
      "content": "When a variant with both the color and size below is added to the cart, the add-on product is added too."
    },
    {
      "type": "product",
      "id": "addon_product",
      "label": "Add-on product",
      "info": "This product is added automatically to the cart."
    },
    {
      "type": "text",
      "id": "trigger_color",
      "label": "Trigger color",
      "default": "Black",
      "info": "Color name of the variant, for example Black."
    },
    {
      "type": "text",
      "id": "trigger_size",
      "label": "Trigger size",
      "default": "Medium",
      "info": "Size name of the variant, for example Medium."
    },
    {
      "type": "header",
      "content": "Texts"
    },
    {
      "type": "text",
      "id": "text_choose",
      "label": "Message when an option is missing",
      "info": "The option name is added at the end, for example \"Please choose your size\".",
      "default": "Please choose your"
    },
    {
      "type": "text",
      "id": "text_added",
      "label": "Notification title (after adding to cart)",
      "default": "Added to cart"
    },
    {
      "type": "text",
      "id": "text_view_cart",
      "label": "Notification link label",
      "default": "View cart"
    },
    {
      "type": "text",
      "id": "text_addon_added",
      "label": "Message when the add-on product is added",
      "info": "The add-on product name is added at the start.",
      "default": "was added to your cart as an add-on"
    },
    {
      "type": "text",
      "id": "text_sold_out",
      "label": "Message when the variant is sold out",
      "default": "This variant is sold out"
    },
    {
      "type": "header",
      "content": "Section space"
    },
    {
      "type": "range",
      "id": "space_top_desktop",
      "label": "Space above section (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "label": "Space above section (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "space_bottom_desktop",
      "label": "Space below section (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "label": "Space below section (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "header",
          "content": "\"+\" button position (desktop)"
        },
        {
          "type": "range",
          "id": "hotspot_x_desktop",
          "label": "Horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 60
        },
        {
          "type": "range",
          "id": "hotspot_y_desktop",
          "label": "Vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "header",
          "content": "\"+\" button position (mobile)"
        },
        {
          "type": "range",
          "id": "hotspot_x_mobile",
          "label": "Horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 64
        },
        {
          "type": "range",
          "id": "hotspot_y_mobile",
          "label": "Vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 14
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift guide grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
